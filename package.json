{
  "name": "agentree-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=none packages/core/src/*.test.ts packages/storage/src/*.test.ts packages/sync/src/*.test.ts apps/cli/src/*.test.ts demo/*.test.ts",
    "agentree": "node --import tsx apps/cli/src/main.ts",
    "demo": "node --import tsx demo/two-agents.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
