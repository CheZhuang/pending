{
  "name": "agentree-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && npm --prefix apps/web run build",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test --test-isolation=none packages/core/src/*.test.ts packages/storage/src/*.test.ts packages/sync/src/*.test.ts packages/adapters/src/*.test.ts packages/mcp/src/*.test.ts apps/cli/src/*.test.ts src/*.test.ts demo/*.test.ts",
    "agentree": "node --import tsx apps/cli/src/main.ts",
    "demo": "node --import tsx demo/two-agents.ts",
    "smoke:native": "node --import tsx demo/native-smoke.ts",
    "demo:real": "node --import tsx demo/real-two-agents.ts",
    "codex:managed": "node --import tsx apps/cli/src/codex-runner.ts",
    "task": "node --import tsx apps/cli/src/task.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "koffi": "^3.3.7",
    "systeminformation": "^5.33.19",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "agentree": "dist/apps/cli/src/main.js"
  }
}
